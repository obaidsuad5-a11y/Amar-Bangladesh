PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/amar_bangladesh_news
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1d
ADMIN_NAME=Portal Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
NEWS_API_KEY=
NEWS_API_COUNTRY=us
CLIENT_ORIGIN=http://localhost:5000

# Public production origin (canonical URLs)
PUBLIC_URL=http://localhost:5000
# Cloudinary optional cloud media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# AI provider: OpenAI-compatible Chat Completions endpoint
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Web Push VAPID (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
